{$DEMO_DOMAIN} {
    encode zstd gzip
    handle /operations {
        redir /operations/ 308
    }
    handle /operations/api/* {
        uri strip_prefix /operations
        reverse_proxy api:8000
    }
    handle_path /operations/* {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    handle / {
        root * /landing
        file_server
    }
    handle {
        respond 404
    }
}
